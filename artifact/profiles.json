{
  "format": "artifact-profiles-v1",
  "note": "Plan by default; --execute runs stages sequentially. Historical sample counts and gates match supplied manuscript \u00a74 and Appendix H.3. October rebuttal remains a separate supplemental campaign.",
  "profiles": {
    "smoke": {
      "hardware": false,
      "stages": [
        {
          "id": "portable",
          "argv": [
            "{python}",
            "scripts/artifact.py",
            "smoke",
            "--output",
            "{output}/portable"
          ]
        },
        {
          "id": "analysis",
          "argv": [
            "{python}",
            "scripts/artifact.py",
            "analyze",
            "--output",
            "{output}/analysis"
          ]
        }
      ]
    },
    "paper": {
      "hardware": true,
      "stages": [
        {
          "id": "prompt",
          "argv": [
            "{python}",
            "scripts/run_rebuttal_diagnostics.py",
            "--output",
            "{output}/prompt-control",
            "--timeout",
            "7200",
            "--",
            "{python}",
            "scripts/run_llama_cpp_qpu_ffn_island_eval.py",
            "--llama-root",
            "{LLAMA_ROOT}",
            "--llama-bench",
            "{LLAMA_ROOT}/build/bin/llama-bench",
            "--model",
            "{GEMMA_MODEL}",
            "--rows",
            "129,257",
            "--fractions",
            "0.125",
            "--repetitions",
            "5",
            "--skip-verification",
            "--skip-fallback",
            "--plugin",
            "{INTEGRATION_BUILD}/libggml-qpu-inline.so",
            "--stride-smoke",
            "{INTEGRATION_BUILD}/qpu_repack_stride_smoke",
            "--graph-smoke",
            "{INTEGRATION_BUILD}/qpu_ffn_island_graph_smoke",
            "--model-smoke",
            "{INTEGRATION_BUILD}/qpu_ffn_island_model_smoke",
            "--output",
            "{output}/prompt.json"
          ]
        },
        {
          "id": "agentic",
