{
  "format": "artifact-profiles-v1",
  "note": "Bounded clean-build exercisability check. Reduced process count is explicitly diagnostic and does not replace paper confirmation. Numerical, dispatch, environment and retention gates are unchanged.",
  "profiles": {
    "paper": {
      "hardware": true,
      "stages": [
        {
          "id": "prompt",
          "argv": [
            "{python}",
            "scripts/run_rebuttal_diagnostics.py",
            "--output",
            "{output}/prompt-control",
            "--timeout",
            "7200",
            "--",
            "{python}",
            "scripts/run_llama_cpp_qpu_ffn_island_eval.py",
            "--llama-root",
            "{LLAMA_ROOT}",
            "--llama-bench",
            "{LLAMA_ROOT}/build/bin/llama-bench",
            "--model",
            "{GEMMA_MODEL}",
            "--rows",
            "129",
            "--fractions",
            "0.125",
            "--repetitions",
            "2",
            "--skip-verification",
            "--skip-fallback",
            "--plugin",
            "{INTEGRATION_BUILD}/libggml-qpu-inline.so",
            "--stride-smoke",
            "{INTEGRATION_BUILD}/qpu_repack_stride_smoke",
            "--graph-smoke",
            "{INTEGRATION_BUILD}/qpu_ffn_island_graph_smoke",
            "--model-smoke",
            "{INTEGRATION_BUILD}/qpu_ffn_island_model_smoke",
            "--output",
            "{output}/prompt.json"
          ]
        },
        {
          "id": "agentic",
          "argv": [
            "{python}",
            "scripts/run_rebuttal_diagnostics.py",
            "--output",
            "{output}/agentic-control",
            "--timeout",
            "7200",
            "--",
            "{python}",
            "scripts/run_llama_cpp_qpu_ffn_island_agentic_eval.py",
            "--llama-root",
            "{LLAMA_ROOT}",
            "--server",
            "{LLAMA_ROOT}/build/bin/llama-server",
            "--model",
            "{GEMMA_MODEL}",
            "--plugin",
            "{INTEGRATION_BUILD}/libggml-qpu-inline.so",
            "--prefix",
            "512",
            "--suffixes",
            "128",
            "--fraction",
            "0.125",
            "--samples",
            "2",
            "--stride-smoke",
            "{INTEGRATION_BUILD}/qpu_repack_stride_smoke",
            "--graph-smoke",
            "{INTEGRATION_BUILD}/qpu_ffn_island_graph_smoke",
            "--model-smoke",
            "{INTEGRATION_BUILD}/qpu_ffn_island_model_smoke",
            "--output",
            "{output}/agentic.json"
          ]
        }
      ]
    }
  }
}
