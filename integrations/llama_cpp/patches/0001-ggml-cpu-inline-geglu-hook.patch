+        char * qpu_end = nullptr;
+        const unsigned long long qpu = std::strtoull(total_end + 1, &qpu_end, 10);
+        if (qpu_end == total_end + 1 || qpu == 0 || qpu >= total) {
+            return 0;
+        }
+        if (total == rows) {
