+    const char * value = std::getenv("GGML_QPU_CPU_INLINE_ROWS");
+    if (value == nullptr || value[0] == '\0') {
+        return true;
+    }
+    while (*value != '\0') {
+        char * end = nullptr;
+        const unsigned long long candidate = std::strtoull(value, &end, 10);
+        if (end == value) {
